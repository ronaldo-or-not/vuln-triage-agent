# 로컬 기본값: 유닉스 소켓으로 vulnagent DB에 접속
DATABASE_URL=postgresql:///vulnagent
# 서버(소켓 디렉터리를 홈에 둔 경우) 예:
# DATABASE_URL=postgresql:///vulnagent?host=/home/USER/vuln-triage-agent/.pgsock

# 있으면 NVD 한도가 30초 5회 -> 50회 (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# 1이면 네트워크를 쓰지 않고 DB 캐시만 사용 (평가 재현용)
VULNAGENT_OFFLINE=0

OSV_QUERY_TTL_HOURS=24
NVD_TTL_HOURS=168
NVD_PENDING_TTL_HOURS=24
NVD_NOTFOUND_TTL_HOURS=24
BULK_REFRESH_HOURS=24
KEEP_SNAPSHOTS=7
